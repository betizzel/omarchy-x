{
  "manifest_version": 3,
  "name": "Omarchy X Theme",
  "version": "1.0.0",
  "description": "Styles x.com with the active Omarchy theme colors and font.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["theme.css"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
